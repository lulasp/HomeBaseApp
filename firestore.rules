rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(householdId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    match /households/{householdId} {
      // Any authenticated user can query households (needed for join-by-invite-code)
      allow read: if request.auth != null;

      // Creator must include themselves in the initial members array
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;

      // Members can edit freely; non-members can only add themselves (joining via invite code)
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          !resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet())
               == [request.auth.uid].toSet()
        )
      );

      // Households cannot be deleted from the client
      allow delete: if false;

      // All subcollections (groceryItems, pantryItems, recipes, etc.) — members only
      match /{subcollection}/{docId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
